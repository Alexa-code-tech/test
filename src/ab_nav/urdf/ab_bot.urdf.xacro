<?xml version="1.0"?>
<robot name="ab_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="blue"><color rgba="0.1 0.3 0.8 1"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>

  <xacro:macro name="small_inertial" params="m">
    <inertial><mass value="${m}"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </xacro:macro>

  <xacro:macro name="wheel" params="name y">
    <link name="${name}_wheel">
      <visual><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.05" length="0.04"/></geometry><material name="black"/></visual>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.05" length="0.04"/></geometry></collision>
      <inertial><mass value="0.3"/><inertia ixx="0.00023" ixy="0" ixz="0" iyy="0.000375" iyz="0" izz="0.00023"/></inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_wheel"/>
      <origin xyz="0 ${y} 0"/><axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${name}_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  </xacro:macro>

  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster">
      <collision><geometry><sphere radius="0.025"/></geometry></collision>
      <visual><geometry><sphere radius="0.025"/></geometry><material name="grey"/></visual>
      <xacro:small_inertial m="0.05"/>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/><child link="${name}_caster"/><origin xyz="${x} 0 -0.025"/>
    </joint>
    <gazebo reference="${name}_caster"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  </xacro:macro>

  <!-- корпус -->
  <link name="base_footprint"/>
  <joint name="footprint_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.05"/>
  </joint>
  <link name="base_link">
    <visual><origin xyz="0 0 0.03"/><geometry><box size="0.30 0.20 0.10"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="0 0 0.03"/><geometry><box size="0.30 0.20 0.10"/></geometry></collision>
    <inertial><origin xyz="0 0 0.03"/><mass value="3.0"/>
      <inertia ixx="0.0125" ixy="0" ixz="0" iyy="0.025" iyz="0" izz="0.0325"/></inertial>
  </link>

  <xacro:wheel name="left" y="0.125"/>
  <xacro:wheel name="right" y="-0.125"/>
  <xacro:caster name="front" x="0.12"/>
  <xacro:caster name="rear" x="-0.12"/>

  <!-- 2D лидар -->
  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.04" length="0.04"/></geometry><material name="black"/></visual>
    <xacro:small_inertial m="0.1"/>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/><origin xyz="0 0 0.10"/>
  </joint>

  <!-- depth-камера (аналог Orbbec Astra) -->
  <link name="camera_link">
    <visual><geometry><box size="0.03 0.08 0.03"/></geometry><material name="black"/></visual>
    <xacro:small_inertial m="0.1"/>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/><origin xyz="0.14 0 0.06"/>
  </joint>
  <link name="camera_depth_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_depth_optical_frame"/>
    <origin rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- GPS -->
  <link name="gps_link">
    <visual><geometry><box size="0.04 0.04 0.01"/></geometry><material name="grey"/></visual>
    <xacro:small_inertial m="0.05"/>
  </link>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="0 0 0.10"/>
  </joint>

  <!-- Gazebo: привод и joint states -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <update_rate>30</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.25</wheel_separation>
      <wheel_diameter>0.10</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
    <plugin name="joint_states" filename="libgazebo_ros_joint_state_publisher.so">
      <update_rate>20</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- Лидар -> /scan -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="ray">
      <always_on>true</always_on><visualize>false</visualize><update_rate>10</update_rate>
      <ray>
        <scan><horizontal><samples>360</samples><resolution>1</resolution>
          <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.12</min><max>6.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Depth-камера -> /astra/image_raw, /astra/depth/image_raw, /astra/points -->
  <gazebo reference="camera_link">
    <sensor name="astra" type="depth">
      <always_on>true</always_on><visualize>false</visualize><update_rate>10</update_rate>
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>
        <image><width>160</width><height>120</height><format>R8G8B8</format></image>
        <clip><near>0.6</near><far>5.0</far></clip>
      </camera>
      <plugin name="astra_plugin" filename="libgazebo_ros_camera.so">
        <camera_name>astra</camera_name>
        <frame_name>camera_depth_optical_frame</frame_name>
        <min_depth>0.6</min_depth>
        <max_depth>5.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

  <!-- GPS -> /gps/fix -->
  <gazebo reference="gps_link">
    <sensor name="gps" type="gps">
      <always_on>true</always_on><update_rate>5</update_rate>
      <plugin name="gps_plugin" filename="libgazebo_ros_gps_sensor.so">
        <ros><remapping>~/out:=gps/fix</remapping></ros>
        <frame_name>gps_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
